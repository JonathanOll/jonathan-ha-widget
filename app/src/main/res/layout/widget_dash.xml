<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget_off"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/d_thermo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_thermo" />
        <TextView
            android:id="@+id/d_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/d_hum"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:textColor="#9A9CA3"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/d_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="#9A9CA3"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:text="ÉCLAIRAGE &amp; PC"
        android:textColor="#B3FFC107"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/t_light"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_light"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_bulb"
                android:contentDescription="Lumière" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lumière"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/s_light"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9CA3"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/t_pc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_pc"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_pc"
                android:contentDescription="PC" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PC"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/s_pc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9CA3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:text="VOLET"
        android:textColor="#B3FFC107"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/t_up"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_up"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_up"
                android:contentDescription="Ouvrir" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ouvrir"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/t_stop"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_stop"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_stop"
                android:contentDescription="Stop" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stop"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/t_down"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_down"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_down"
                android:contentDescription="Fermer" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fermer"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:text="TÉLÉ"
        android:textColor="#B3FFC107"
        android:textSize="10sp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/t_all"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1.4"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_all"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_power"
                android:contentDescription="Tout" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tout"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/s_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9CA3"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/t_tv"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_tv"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_tv"
                android:contentDescription="Télé" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Télé"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/s_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9CA3"
                android:textSize="10sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/t_led"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_margin="3dp"
            android:background="@drawable/bg_btn"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="4dp">
            <ImageView
                android:id="@+id/i_led"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_led"
                android:contentDescription="LED" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LED"
                android:textColor="#E6E6E9"
                android:textSize="11sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/s_led"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9A9CA3"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
